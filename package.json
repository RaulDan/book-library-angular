{
  "name": "book-library-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4200",
    "start:mock-server": "node angular-static-mock-server/server.js",
    "start-all-angular": "concurrently \"npm run serve:federation\" \"npm run start:mock-server\"",
    "build": "ng build",
    "build:federation": "webpack --config webpack.federation.cjs --mode production",
    "serve:federation": "webpack serve --config webpack.federation.cjs --mode development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@ngtools/webpack": "~22.2.4",
    "@babel/core": "^8.1.3",
    "babel-loader": "^10.1.1",
    "webpack": "5.112.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "sass": "^1.97.0",
    "sass-loader": "^16.0.6",
    "css-loader": "^7.1.2",
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
