{
  "name": "book-library-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4200",
    "start:mock-server": "node angular-static-mock-server/server.js",
    "start-all-angular": "concurrently \"npm run start\" \"npm run start:mock-server\"",
    "build": "ng build",
    "build:federation": "ng run book-library-angular:build-federation:production",
    "start:federation": "ng run book-library-angular:serve-federation",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "22.0.1",
    "@angular-devkit/build-angular": "22.2.5",
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.3",
    "jsdom": "^30.0.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "webpack": "^5.106.0"
  }
}
